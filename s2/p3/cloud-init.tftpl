#cloud-config
hostname: ${hostname}
users:
  - name: student
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_key}
package_update: true
packages: [nginx, curl]
write_files:
  - path: /var/www/html/index.html
    content: |
      <h1>${hostname}</h1>
runcmd:
  - systemctl enable --now nginx
